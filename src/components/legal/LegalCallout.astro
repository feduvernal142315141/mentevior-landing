---
// Las advertencias que no pueden leerse como un párrafo más: que publicar el
// BAA no crea la relación, que los formularios públicos no admiten PHI, que
// el sitio no atiende emergencias. `critical` reserva el rojo para la última.
interface Props {
  title?: string;
  critical?: boolean;
}

const { title, critical = false } = Astro.props;

const icon = critical
  ? "M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"
  : "M12 16v-4m0-4h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z";
---

<aside class:list={["legal-callout", critical && "legal-callout--critical"]}>
  <svg
    class="legal-callout-icon"
    width="19"
    height="19"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={icon} />
  </svg>
  <div>
    {title && <strong class="legal-callout-title">{title}</strong>}
    <slot />
  </div>
</aside>
