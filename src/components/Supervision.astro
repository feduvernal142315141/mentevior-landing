---
import StatusChip from "./StatusChip.astro";

const items = [
  {
    title: "Monthly supervision reports",
    body: "Supervised hours, applied options and both signatures — assembled from the month's 97155 appointments, not re-typed.",
  },
  {
    title: "Case supervision logs",
    body: "Supervision coverage per client with the percentage calculated for you, and the requirement marked Met or Unmet.",
  },
  {
    title: "Expiration alerts",
    body: "Credentials, client documents and HR files with days-remaining tracking, surfaced before they lapse — not after.",
  },
];
---

<section class="px-6 py-[72px] md:px-8 lg:py-[128px]" id="supervision">
  <div class="mx-auto max-w-[1200px] rounded-[32px] bg-page-alt px-6 py-14 md:px-12 lg:px-16 lg:py-20">
    <div class="mx-auto max-w-[720px] text-center">
      <span class="eyebrow-pill text-eyebrow reveal">Compliance</span>
      <h2 class="text-h2 reveal mt-5" style="--reveal-delay: 70ms">
        Supervision and compliance, documented by default
      </h2>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {items.map((item, i) => (
        <div class="feature-card reveal p-7" style={`--reveal-delay: ${i * 70}ms`}>
          <h3 class="text-h3">{item.title}</h3>
          <p class="mt-3 text-body-sm leading-relaxed text-ink-muted">{item.body}</p>
        </div>
      ))}
    </div>

    <!-- Medidor de cumplimiento. Escala 0–20%: 12.4% → barra al 62%,
         requisito 10% → marca al 50%. Los números y la geometría cuadran. -->
    <div class="reveal mx-auto mt-10 flex max-w-[440px] items-center gap-5 rounded-card border border-line bg-white p-6" style="box-shadow: var(--shadow-card); --reveal-delay: 210ms" aria-hidden="true">
      <div class="flex-1">
        <div class="flex items-baseline justify-between">
          <span class="text-micro font-medium text-ink-muted">Supervision coverage</span>
          <span class="text-[15px] font-semibold tabular-nums"><span data-count="12.4">12.4</span>%</span>
        </div>
        <div class="mt-2 h-2.5 overflow-hidden rounded-full bg-[hsl(240_15%_93%)]">
          <div class="relative h-full w-full">
            <div class="meter-fill h-full rounded-full bg-gradient-to-r from-brand-500 to-brand-400" style="--meter: 62%"></div>
            <span class="absolute top-[-4px] h-[18px] w-0.5 rounded bg-ink-muted/50" style="left: 50%"></span>
          </div>
        </div>
        <p class="mt-1.5 text-[11px] text-ink-muted">Requirement: at least 10% of total hours</p>
      </div>
      <StatusChip class="px-2.5 py-1">Met</StatusChip>
    </div>
  </div>
</section>
