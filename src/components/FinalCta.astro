---
import { CALENDLY_URL, CONTACT_EMAIL } from "../config";
---

<section class="relative overflow-hidden bg-indigo-900 py-[72px] lg:py-[128px]" id="demo">
  <div
    class="pointer-events-none absolute -right-24 -top-32 h-[560px] w-[560px] rounded-full"
    style="background: radial-gradient(circle, rgba(90,200,250,0.12), transparent 65%)"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[760px] px-6 text-center md:px-8">
    <h2 class="text-h2 reveal text-white">See MenteVior with your own workflows</h2>
    <p class="text-body-lg reveal mt-5 text-white/70" style="--reveal-delay: 70ms">
      A 30-minute walkthrough with someone who knows ABA operations — your billing codes,
      your supervision requirements, your payers.
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-3.5" style="--reveal-delay: 140ms">
      <a href={CALENDLY_URL} data-calendly class="btn-on-dark-primary">Book a demo</a>
      <a href="#features" class="btn-on-dark-ghost">Explore the product</a>
    </div>

    <p class="reveal mt-7 text-caption text-white/60" style="--reveal-delay: 210ms">
      No credit card&ensp;·&ensp;No setup fee to evaluate&ensp;·&ensp;Prefer email?&nbsp;
      <a
        href={`mailto:${CONTACT_EMAIL}?subject=Demo%20request`}
        class="font-medium text-white/80 underline decoration-white/30 underline-offset-4 transition-colors hover:text-white"
      >
        {CONTACT_EMAIL}
      </a>
    </p>
  </div>
</section>
