---
// Nav en dos estados: transparente e integrado al hero en reposo; al scrollear
// se "desprende" como barra flotante (blur, borde, radio, altura reducida).
// El menú mobile es un sheet flotante con overlay — no un div que empuja todo.

const links = [
  { label: "Product", href: "#product", num: "01" },
  { label: "Features", href: "#features", num: "02" },
  { label: "Security", href: "#security", num: "03" },
  { label: "Pricing", href: "#pricing", num: "04" },
];
---

<header class="site-nav enter-fade fixed inset-x-0 top-0 z-50" id="site-nav" style="--d: 0ms">
  <div class="nav-shell flex items-center justify-between">
    <a href="/" class="flex items-center gap-2.5" aria-label="MenteVior home">
      <img src="/logoMenteVior.png" alt="" class="h-9 w-9 object-contain" width="36" height="36" />
      <span class="text-[19px] font-bold tracking-[-0.02em]">
        <span class="text-indigo-900">Mente</span><span class="text-brand-400">Vior</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a
        href="#demo"
        class="text-[14.5px] font-semibold text-ink-secondary transition-colors duration-200 hover:text-ink"
      >
        Sign in
      </a>
      <a href="#demo" class="btn-primary !h-11">Request a demo</a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="nav-burger lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>
</header>

<!-- Overlay + sheet viven fuera del header para no heredar su stacking -->
<div class="menu-overlay lg:hidden" id="menu-overlay" aria-hidden="true"></div>

<div
  class="mobile-sheet lg:hidden"
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  inert
>
  <nav class="p-3" aria-label="Mobile">
    {links.map((link) => (
      <div class="sheet-item">
        <a href={link.href} class="sheet-link">
          <span>{link.label}</span>
          <span class="sheet-num" aria-hidden="true">{link.num}</span>
        </a>
      </div>
    ))}

    <div class="sheet-item my-2 border-t border-line"></div>

    <div class="sheet-item p-1.5">
      <a href="#demo" class="btn-primary w-full">Request a demo</a>
    </div>
  </nav>
</div>

<script>
  const nav = document.getElementById("site-nav")!;
  const toggle = document.getElementById("menu-toggle")!;
  const overlay = document.getElementById("menu-overlay")!;
  const sheet = document.getElementById("mobile-menu")! as HTMLElement & { inert: boolean };

  // ── Estado scrolled ──
  let menuOpen = false;
  const syncScrolled = () =>
    nav.classList.toggle("is-scrolled", menuOpen || window.scrollY > 24);
  syncScrolled();
  window.addEventListener("scroll", syncScrolled, { passive: true });

  // ── Menú mobile ──
  const setOpen = (open: boolean) => {
    menuOpen = open;
    sheet.classList.toggle("is-open", open);
    overlay.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    sheet.inert = !open;
    // Overlay activo ⇒ el fondo no debe scrollear
    document.body.style.overflow = open ? "hidden" : "";
    // Con el sheet abierto el nav necesita fondo aunque estemos arriba del todo
    syncScrolled();

    if (open) {
      (sheet.querySelector("a") as HTMLElement | null)?.focus({ preventScroll: true });
    } else {
      toggle.focus({ preventScroll: true });
    }
  };

  toggle.addEventListener("click", () => setOpen(!menuOpen));
  overlay.addEventListener("click", () => setOpen(false));
  sheet.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false)),
  );
  // Escape cierra; Tab queda ciclando entre el toggle y el sheet mientras está
  // abierto — es lo que aria-modal promete.
  document.addEventListener("keydown", (e) => {
    if (!menuOpen) return;

    if (e.key === "Escape") {
      setOpen(false);
      return;
    }

    if (e.key !== "Tab") return;
    const focusables = [toggle, ...sheet.querySelectorAll<HTMLElement>("a")];
    const first = focusables[0];
    const last = focusables[focusables.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
