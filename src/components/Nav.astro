---
// Nav a ancho completo (patrón Linear/Stripe/Vercel): transparente sobre el
// hero; al scrollear gana blur, borde inferior hairline y comprime 72→64px.
// El menú mobile es pantalla completa, sin adornos: links grandes, divisores
// finos y las acciones al fondo.

const links = [
  { label: "Product", href: "#product" },
  { label: "Features", href: "#features" },
  { label: "Security", href: "#security" },
  { label: "Pricing", href: "#pricing" },
];
---

<header class="site-nav enter-fade fixed inset-x-0 top-0 z-50" id="site-nav" style="--d: 0ms">
  <div class="nav-inner">
    <a href="/" class="flex items-center gap-2.5" aria-label="MenteVior home">
      <img src="/logoMenteVior.png" alt="" class="h-9 w-9 object-contain" width="36" height="36" />
      <span class="text-[19px] font-bold tracking-[-0.02em]">
        <span class="text-indigo-900">Mente</span><span class="text-brand-400">Vior</span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {links.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a
        href="#demo"
        class="text-[14.5px] font-semibold text-ink-secondary transition-colors duration-200 hover:text-ink"
      >
        Sign in
      </a>
      <a href="#demo" class="btn-primary h-11">Request a demo</a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="nav-burger lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>
</header>

<!-- Menú mobile: pantalla completa bajo el nav. Vive fuera del header para no
     heredar su stacking; el nav (z-50) queda visible encima con la X. -->
<div
  class="mobile-menu lg:hidden"
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  inert
>
  <nav class="flex-1 overflow-y-auto px-6" aria-label="Mobile">
    {links.map((link) => <a href={link.href} class="mobile-menu-link">{link.label}</a>)}
  </nav>

  <div class="space-y-3 px-6 pb-8 pt-4">
    <a href="#demo" class="btn-primary w-full">Request a demo</a>
    <a href="#demo" class="btn-ghost w-full">Sign in</a>
  </div>
</div>

<script>
  const nav = document.getElementById("site-nav")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")! as HTMLElement & { inert: boolean };

  // ── Estado scrolled ──
  let menuOpen = false;
  const syncScrolled = () =>
    nav.classList.toggle("is-scrolled", menuOpen || window.scrollY > 24);
  syncScrolled();
  window.addEventListener("scroll", syncScrolled, { passive: true });

  // ── Menú mobile ──
  const setOpen = (open: boolean) => {
    menuOpen = open;
    menu.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.inert = !open;
    document.body.style.overflow = open ? "hidden" : "";
    // Con el menú abierto el nav necesita fondo aunque estemos arriba del todo
    syncScrolled();

    if (open) {
      (menu.querySelector("a") as HTMLElement | null)?.focus({ preventScroll: true });
    } else {
      toggle.focus({ preventScroll: true });
    }
  };

  toggle.addEventListener("click", () => setOpen(!menuOpen));
  menu.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false)),
  );

  // Escape cierra; Tab cicla entre el toggle y el menú — lo que aria-modal promete
  document.addEventListener("keydown", (e) => {
    if (!menuOpen) return;

    if (e.key === "Escape") {
      setOpen(false);
      return;
    }

    if (e.key !== "Tab") return;
    const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>("a")];
    const first = focusables[0];
    const last = focusables[focusables.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
