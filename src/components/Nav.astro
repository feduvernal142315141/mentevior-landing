---
// Nav a ancho completo (patrón Linear/Stripe/Vercel): transparente sobre el
// hero; al scrollear gana blur, borde inferior hairline y comprime 72→64px.
// "Product" abre un panel de vidrio con las seis áreas del producto; el
// scroll-spy marca la sección visible. El menú mobile es una escena de vidrio
// a pantalla completa con los links agrupados (Product / Company) en stagger.

import Logo from "./Logo.astro";
import { CALENDLY_URL } from "../config";

const productLinks = [
  {
    label: "Session notes & documentation",
    desc: "97153 · 97155 · 97156, CASP guidance",
    href: "#clinical",
    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm0 0v6h6",
  },
  {
    label: "Data collection",
    desc: "Five methods, charted automatically",
    href: "#data",
    icon: "M3 3v18h18M7 14l4-4 3 3 5-6",
  },
  {
    label: "Operations & billing",
    desc: "Authorizations, scheduling, claims",
    href: "#operations",
    icon: "M8 2v4m8-4v4M4 8h16M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
  },
  {
    label: "Supervision & compliance",
    desc: "Coverage tracked, reports assembled",
    href: "#supervision",
    icon: "M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z",
  },
  {
    label: "Improve with AI",
    desc: "Session narratives, improved in one click",
    href: "#ai",
    icon: "m12 3 1.9 5.6L19.5 10.5l-5.6 1.9L12 18l-1.9-5.6L4.5 10.5l5.6-1.9L12 3ZM19 15l.9 2.6L22.5 18.5l-2.6.9L19 22l-.9-2.6L15.5 18.5l2.6-.9L19 15Z",
  },
  {
    label: "Configurability",
    desc: "Roles, templates and plans per clinic",
    href: "#configurability",
    icon: "M4 21v-7m0-4V3m8 18v-9m0-4V3m8 18v-5m0-4V3M1 14h6m2-6h6m2 8h6",
  },
  {
    label: "Who it's for",
    desc: "BCBA, RBT, owner, billing & ops",
    href: "#roles",
    icon: "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75",
  },
  {
    label: "Security",
    desc: "HIPAA, encryption, full audit trail",
    href: "#security",
    icon: "M19 11H5a2 2 0 0 0-2 2v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7a2 2 0 0 0-2-2Zm-12 0V7a5 5 0 0 1 10 0v4",
  },
];

const companyLinks = [
  { label: "How it works", href: "#how" },
  { label: "Why MenteVior", href: "#why" },
  { label: "Pricing", href: "#pricing" },
  { label: "FAQ", href: "#faq" },
];
---

<header class="site-nav enter-fade fixed inset-x-0 top-0 z-50" id="site-nav" style="--d: 0ms">
  <div class="nav-inner">
    <Logo />

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      <div class="nav-item" id="product-nav-item" data-open="false">
        <button
          type="button"
          class="nav-trigger"
          id="product-trigger"
          aria-expanded="false"
          aria-controls="product-panel"
        >
          Product
          <svg
            class="nav-caret"
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6" />
          </svg>
        </button>

        <div class="nav-panel" id="product-panel">
          {productLinks.map((link) => (
            <a href={link.href} class="nav-panel-link">
              <span class="icon-tile mt-0.5 h-9 w-9 rounded-[10px]">
                <svg
                  width="17"
                  height="17"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={link.icon} />
                </svg>
              </span>
              <span>
                <span class="nav-panel-title block">{link.label}</span>
                <span class="nav-panel-desc block">{link.desc}</span>
              </span>
            </a>
          ))}
        </div>
      </div>

      {companyLinks.map((link) => <a href={link.href} class="nav-link">{link.label}</a>)}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <!-- "Sign in" vuelve cuando exista una URL pública de la app -->
      <a href={CALENDLY_URL} data-calendly class="btn-primary h-11">Book a demo</a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="nav-burger lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="burger-line"></span>
      <span class="burger-line"></span>
      <span class="burger-line"></span>
    </button>
  </div>
</header>

<!-- Menú mobile: pantalla completa bajo el nav. Vive fuera del header para no
     heredar su stacking; el nav (z-50) queda visible encima con la X. -->
<div
  class="mobile-menu lg:hidden"
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  inert
>
  <nav class="relative flex-1 overflow-y-auto px-6 pt-0" aria-label="Mobile">
    <span class="mobile-menu-group menu-enter" style="--i: 0">Product</span>
    {productLinks.map((link, i) => (
      <a href={link.href} class="mobile-menu-link mobile-menu-link--sm menu-enter" style={`--i: ${i + 1}`}>
        {link.label}
        <svg
          class="menu-arrow"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </a>
    ))}

    <span class="mobile-menu-group menu-enter" style="--i: 9">Company</span>
    {companyLinks.map((link, i) => (
      <a href={link.href} class="mobile-menu-link mobile-menu-link--sm menu-enter" style={`--i: ${i + 10}`}>
        {link.label}
        <svg
          class="menu-arrow"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M7 17 17 7" />
          <path d="M8 7h9v9" />
        </svg>
      </a>
    ))}
  </nav>

  <div class="menu-enter relative space-y-3 px-6 pb-4 pt-4" style="--i: 14">
    <a href={CALENDLY_URL} data-calendly class="btn-primary w-full">Book a demo</a>
  </div>

  <p class="menu-enter relative px-6 pb-8 pt-1 text-center text-micro text-ink-muted" style="--i: 15">
    HIPAA compliant · Role-based access · Built with BCBAs
  </p>
</div>

<script>
  const nav = document.getElementById("site-nav")!;
  const toggle = document.getElementById("menu-toggle")!;
  const menu = document.getElementById("mobile-menu")! as HTMLElement & { inert: boolean };

  // ── Estado scrolled ──
  let menuOpen = false;
  const syncScrolled = () =>
    nav.classList.toggle("is-scrolled", menuOpen || window.scrollY > 24);
  syncScrolled();
  window.addEventListener("scroll", syncScrolled, { passive: true });

  // ── Dropdown de Product (desktop) ──
  const productItem = document.getElementById("product-nav-item")!;
  const productTrigger = document.getElementById("product-trigger")!;
  let dropdownOpen = false;
  let closeTimer: ReturnType<typeof setTimeout> | undefined;

  const setDropdown = (open: boolean) => {
    dropdownOpen = open;
    clearTimeout(closeTimer);
    productItem.dataset.open = String(open);
    productTrigger.setAttribute("aria-expanded", String(open));
  };

  productTrigger.addEventListener("click", () => setDropdown(!dropdownOpen));

  // Con puntero fino, abre al hover con una gracia de 160ms para salir
  if (matchMedia("(pointer: fine)").matches) {
    productItem.addEventListener("mouseenter", () => setDropdown(true));
    productItem.addEventListener("mouseleave", () => {
      closeTimer = setTimeout(() => setDropdown(false), 160);
    });
  }

  document.addEventListener("click", (e) => {
    if (dropdownOpen && !productItem.contains(e.target as Node)) setDropdown(false);
  });

  // Cerrar al elegir un destino y al perder el foco por teclado
  productItem.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setDropdown(false)),
  );
  productItem.addEventListener("focusout", (e) => {
    if (!productItem.contains((e as FocusEvent).relatedTarget as Node)) setDropdown(false);
  });

  // ── Scroll-spy: marca el link de la sección visible ──
  const spyTargets: Record<string, string> = {
    product: "product-trigger",
    features: "product-trigger",
    clinical: "product-trigger",
    data: "product-trigger",
    operations: "product-trigger",
    ai: "product-trigger",
    supervision: "product-trigger",
    roles: "product-trigger",
    configurability: "product-trigger",
    security: "product-trigger",
    how: "nav-how",
    why: "nav-why",
    pricing: "nav-pricing",
    faq: "nav-faq",
  };
  const navFor = (id: string) => {
    const target = spyTargets[id];
    if (!target) return null;
    return target.startsWith("nav-")
      ? document.querySelector<HTMLElement>(`nav[aria-label="Main"] a[href="#${target.slice(4)}"]`)
      : document.getElementById(target);
  };

  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        document
          .querySelectorAll(".nav-link.is-active, .nav-trigger.is-active")
          .forEach((el) => el.classList.remove("is-active"));
        navFor(entry.target.id)?.classList.add("is-active");
      }
    },
    // Banda central: la sección "activa" es la que cruza el medio del viewport
    { rootMargin: "-35% 0px -55% 0px" },
  );
  Object.keys(spyTargets).forEach((id) => {
    const el = document.getElementById(id);
    if (el) spy.observe(el);
  });

  // ── Menú mobile ──
  const setOpen = (open: boolean) => {
    menuOpen = open;
    menu.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    menu.inert = !open;
    document.body.style.overflow = open ? "hidden" : "";
    // Con el menú abierto el nav necesita fondo aunque estemos arriba del todo
    syncScrolled();

    if (open) {
      (menu.querySelector("a") as HTMLElement | null)?.focus({ preventScroll: true });
    } else {
      toggle.focus({ preventScroll: true });
    }
  };

  toggle.addEventListener("click", () => setOpen(!menuOpen));
  menu.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => setOpen(false)),
  );

  // Escape cierra; Tab cicla entre el toggle y el menú — lo que aria-modal promete
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && dropdownOpen) {
      setDropdown(false);
      productTrigger.focus();
      return;
    }

    if (!menuOpen) return;

    if (e.key === "Escape") {
      setOpen(false);
      return;
    }

    if (e.key !== "Tab") return;
    const focusables = [toggle, ...menu.querySelectorAll<HTMLElement>("a")];
    const first = focusables[0];
    const last = focusables[focusables.length - 1];

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });
</script>
