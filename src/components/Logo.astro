---
// Emblema + wordmark — el mismo en Nav y Footer. `dark` = sobre fondo índigo.
import { Image } from "astro:assets";
import emblem from "../assets/logo-emblem.png";

interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---

<a href="/" class="flex items-center gap-3" aria-label="MenteVior home">
  <Image src={emblem} alt="" width={44} densities={[1, 2]} class="h-11 w-11 object-contain" />
  <span
    class:list={["text-[22px] font-bold tracking-[-0.02em]", dark && "text-white"]}
  >
    {
      dark ? (
        <>Mente<span class="text-brand-300">Vior</span></>
      ) : (
        <>
          <span class="text-indigo-900">Mente</span><span class="text-brand-400">Vior</span>
        </>
      )
    }
  </span>
</a>
