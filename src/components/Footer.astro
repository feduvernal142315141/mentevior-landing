---
// Sin enlaces muertos (#): en un producto HIPAA, un legal muerto resta
// credibilidad. Privacy, Terms y BAA ya son páginas reales, así que la columna
// Legal entra. text-white/60 mínimo sobre indigo-950 para pasar WCAG AA.
import Logo from "./Logo.astro";
import { CALENDLY_URL, CONTACT_EMAIL } from "../config";

// El footer viaja a /trust y /legal/*, donde las secciones de la landing no
// existen: fuera de la home los anchors se emiten absolutos.
const onHome = Astro.url.pathname === "/";
const to = (href: string) => (href.startsWith("#") && !onHome ? `/${href}` : href);

const columns = [
  {
    title: "Product",
    links: [
      { label: "How it works", href: "#how" },
      { label: "Features", href: "#features" },
      { label: "Improve with AI", href: "#ai" },
      { label: "Who it's for", href: "#roles" },
      { label: "Pricing", href: "#pricing" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "Why MenteVior", href: "#why" },
      { label: "FAQ", href: "#faq" },
      { label: "Book a demo", href: CALENDLY_URL, calendly: true },
      { label: "Contact", href: `mailto:${CONTACT_EMAIL}` },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Trust & security", href: "/trust" },
      { label: "Privacy Policy", href: "/legal/privacy" },
      { label: "Website Terms of Use", href: "/legal/terms" },
      { label: "Standard BAA", href: "/legal/baa" },
    ],
  },
];

const year = new Date().getFullYear();
---

<footer class="bg-indigo-950 pt-16 pb-8">
  <div class="mx-auto max-w-[1200px] px-6 md:px-8 lg:px-12">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div>
        <Logo dark />
        <p class="mt-4 max-w-[32ch] text-caption leading-relaxed text-white/60">
          All-in-one practice management and clinical documentation for ABA therapy
          practices.
        </p>
        <address class="text-caption mt-5 not-italic leading-relaxed text-white/50">
          MenteVior LLC<br />
          2328 S. Congress Ave<br />
          West Palm Beach, FL 33406
        </address>
      </div>

      {columns.map((col) => (
        <nav aria-label={col.title}>
          <p class="text-eyebrow !text-[11px] text-white/60">{col.title}</p>
          <ul class="mt-4 space-y-2.5">
            {col.links.map((link) => (
              <li>
                <a
                  href={to(link.href)}
                  data-calendly={link.calendly || undefined}
                  class="text-body-sm text-white/65 transition-colors hover:text-white"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/[0.08] pt-7 sm:flex-row">
      <p class="text-micro text-white/60">© {year} MenteVior LLC. All rights reserved.</p>
      <p class="text-micro text-white/60">
        <a href="/trust" class="transition-colors hover:text-white">HIPAA business associate</a>
        &ensp;·&ensp;Made for the ABA community
      </p>
    </div>
  </div>
</footer>
