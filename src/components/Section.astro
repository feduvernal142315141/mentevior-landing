---
// Contenedor estándar de sección: un solo lugar para el padding vertical
// (72/128) y el ancho/gutter del contenedor. `containerClass` fija el max-width
// (1200px por defecto) y cualquier grid/espaciado interno.
interface Props {
  id?: string;
  class?: string;
  containerClass?: string;
  padded?: boolean;
}

const {
  id,
  class: className,
  containerClass = "max-w-[1200px]",
  padded = true,
} = Astro.props;
---

<section id={id} class:list={[padded && "py-[72px] lg:py-[128px]", className]}>
  <div class:list={["mx-auto px-6 md:px-8 lg:px-12", containerClass]}>
    <slot />
  </div>
</section>
