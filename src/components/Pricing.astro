---
// Estructura sin números (§4.9): los tiers existen en el modelo del backoffice
// (basic/pro/enterprise) pero el precio es a medida. Los CTAs se diferencian
// por tier: demo para Basic/Pro, contacto directo para Enterprise.
import { CALENDLY_URL, CONTACT_EMAIL } from "../config";

const tiers = [
  {
    name: "Basic",
    tagline: "Solo practitioners and new practices",
    featured: false,
    features: [
      "Clinical documentation & session notes",
      "Data collection with live graphing",
      "Scheduling",
      "Client & caregiver management",
      "Generated PDF reports",
    ],
  },
  {
    name: "Pro",
    tagline: "Growing clinics with a team",
    featured: true,
    features: [
      "Everything in Basic",
      "Supervision reports & case logs",
      "Prior authorization unit tracking",
      "Claims & payer management",
      "Credential & document tracking",
      "Role-based permissions",
    ],
  },
  {
    name: "Enterprise",
    tagline: "Multi-site organizations",
    featured: false,
    cta: "Talk to sales",
    features: [
      "Everything in Pro",
      "Multiple locations under one org",
      "Custom service plan configuration",
      "Custom document templates",
      "Priority support",
    ],
  },
];
---

<section class="py-[72px] lg:py-[128px]" id="pricing">
  <div class="mx-auto max-w-[1200px] px-6 md:px-8 lg:px-12">
    <div class="mx-auto max-w-[720px] text-center">
      <span class="eyebrow-pill text-eyebrow reveal">Pricing</span>
      <h2 class="text-h2 reveal mt-5" style="--reveal-delay: 70ms">
        Plans that grow with your practice
      </h2>
    </div>

    <div class="mx-auto mt-16 grid max-w-[1060px] grid-cols-1 items-start gap-6 lg:grid-cols-3">
      {tiers.map((tier, i) => (
        <div
          class:list={[
            "reveal relative rounded-card border bg-white p-8",
            tier.featured
              ? "border-[rgba(3,126,204,0.45)] lg:-translate-y-3"
              : "border-line",
          ]}
          style={`box-shadow: ${tier.featured ? "0 20px 48px -12px rgba(3,126,204,0.18)" : "var(--shadow-card)"}; --reveal-delay: ${i * 70}ms`}
        >
          {tier.featured && (
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-brand-500 px-3.5 py-1.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-white">
              Most popular
            </span>
          )}

          <h3 class="text-h3">{tier.name}</h3>
          <p class="mt-1 text-caption text-ink-muted">{tier.tagline}</p>
          <p class="mt-5 text-[24px] font-semibold tracking-[-0.02em]">Custom pricing</p>

          <ul class="mt-6 space-y-3 border-t border-line pt-6">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-2.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-brand-500" aria-hidden="true">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                <span class="text-caption leading-snug text-ink-secondary">{feature}</span>
              </li>
            ))}
          </ul>

          <a
            href={tier.cta ? `mailto:${CONTACT_EMAIL}?subject=Enterprise%20inquiry` : CALENDLY_URL}
            data-calendly={tier.cta ? undefined : true}
            class:list={["mt-8 w-full", tier.featured ? "btn-primary" : "btn-ghost"]}
          >
            {tier.cta ?? "Book a demo"}
          </a>
        </div>
      ))}
    </div>

    <p class="reveal mt-10 text-center text-caption text-ink-muted" style="--reveal-delay: 210ms">
      Pricing is tailored to your practice size and services.
    </p>
  </div>
</section>
