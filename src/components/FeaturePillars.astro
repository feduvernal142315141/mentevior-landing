---
// Tres filas alternadas texto/visual (§4.5). Cada visual es un mockup del
// producto real en HTML/CSS/SVG — sin capturas, sin fotos.

const rows = [
  {
    eyebrow: "Clinical",
    title: "Documentation that matches how ABA actually works",
    body: "Session notes shaped to each billing code — 97153, 97155, 97156 — with CASP-aligned guidance built into every field. Treatment plans, assessments and clinical monthly reports come out of the same system your team already documents in.",
    bullets: [
      { icon: "file", label: "CASP-aligned templates" },
      { icon: "hash", label: "Per-code note formats" },
      { icon: "pen", label: "Caregiver signatures" },
      { icon: "doc", label: "Generated PDFs" },
    ],
  },
  {
    eyebrow: "Data",
    title: "Collect data fast. See progress instantly.",
    body: "Datasheets and on-site counters built for the pace of a real session. Every occurrence lands on a live graph the moment it's recorded — no export, no transcription, no waiting for the monthly report to find out.",
    bullets: [
      { icon: "grid", label: "Monthly datasheets" },
      { icon: "tap", label: "On-site counters" },
      { icon: "chart", label: "Automatic graphing" },
      { icon: "db", label: "Raw data & analysis" },
    ],
  },
  {
    eyebrow: "Operations",
    title: "Authorizations, scheduling and billing that talk to each other",
    body: "Scheduling with conflict detection, prior authorization unit tracking, claims and payer management, and expiration alerts for credentials and documents — all reading from the same source your clinical team writes to.",
    bullets: [
      { icon: "cal", label: "Conflict-aware scheduling" },
      { icon: "shield", label: "Authorization unit tracking" },
      { icon: "bill", label: "Claims & payers" },
      { icon: "bell", label: "Expiration alerts" },
    ],
  },
];

const iconPaths: Record<string, string> = {
  file: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm0 0v6h6",
  hash: "M4 9h16M4 15h16M10 3 8 21M16 3l-2 18",
  pen: "M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z",
  doc: "M8 2v4m8-4v4M4 8h16M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
  grid: "M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h7v7h-7z",
  tap: "M9 11.5V5a1.5 1.5 0 0 1 3 0v5m0 0V4a1.5 1.5 0 0 1 3 0v6m0 0a1.5 1.5 0 0 1 3 .5v3.5a6 6 0 0 1-6 6h-1a6 6 0 0 1-5-2.7L4.5 15A1.6 1.6 0 0 1 7 13l2 2Z",
  chart: "M3 3v18h18M7 14l4-4 3 3 5-6",
  db: "M12 8c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3Zm8 4c0 1.7-3.6 3-8 3s-8-1.3-8-3M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5",
  cal: "M8 2v4m8-4v4M4 8h16M6 4h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z",
  shield: "M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z",
  bill: "M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1ZM8 8h8m-8 4h8m-8 4h5",
  bell: "M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9m-4.3 13a2 2 0 0 1-3.4 0",
};
---

<section class="py-[72px] lg:py-[128px]" id="features">
  <div class="mx-auto max-w-[1200px] space-y-[80px] px-6 md:px-8 lg:space-y-[96px] lg:px-12">
    {rows.map((row, index) => (
      <div
        class:list={[
          "grid grid-cols-1 items-center gap-10 lg:grid-cols-2 lg:gap-16",
          index === 1 && "lg:grid-cols-[45fr_55fr]",
        ]}
      >
        <div class:list={["reveal", index % 2 === 1 && "lg:order-2"]}>
          <span class="eyebrow-pill text-eyebrow">{row.eyebrow}</span>
          <h2 class="text-h2 mt-5">{row.title}</h2>
          <p class="mt-5 max-w-[62ch] leading-relaxed text-ink-muted">{row.body}</p>
          <ul class="mt-8 grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-2">
            {row.bullets.map((b) => (
              <li class="flex items-center gap-3">
                <span class="icon-tile !h-10 !w-10">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={iconPaths[b.icon]} />
                  </svg>
                </span>
                <span class="text-[14.5px] font-medium">{b.label}</span>
              </li>
            ))}
          </ul>
        </div>

        <div
          class:list={["reveal", index % 2 === 1 && "lg:order-1"]}
          style="--reveal-delay: 120ms"
          aria-hidden="true"
        >
          {index === 0 && (
            <div class="feature-card relative mx-auto max-w-[480px] !rounded-[24px] p-6" style="box-shadow: var(--shadow-float)">
              <div class="flex items-center justify-between">
                <p class="text-[15px] font-semibold">Session Note · 97155</p>
                <span class="rounded-full bg-[rgba(3,126,204,0.08)] px-2.5 py-1 text-[10.5px] font-semibold text-brand-500">Supervision</span>
              </div>
              <div class="mt-4 rounded-2xl border border-line bg-page p-4">
                <p class="text-[11px] font-semibold uppercase tracking-[0.06em] text-ink-muted">Narrative</p>
                <div class="mt-2.5 space-y-2">
                  {[100, 92, 96, 78].map((w) => (
                    <div class="h-2 rounded-full bg-[hsl(240_15%_91%)]" style={`width:${w}%`}></div>
                  ))}
                </div>
                <div class="mt-3 rounded-xl border border-[rgba(3,126,204,0.25)] bg-[rgba(3,126,204,0.05)] p-3">
                  <p class="text-[10.5px] font-semibold text-brand-500">Guidance</p>
                  <p class="mt-1 text-[11px] leading-relaxed text-ink-muted">Describe the protocol modifications observed face-to-face…</p>
                </div>
                <p class="mt-2.5 text-right text-[11px] tabular-nums text-[hsl(142_60%_32%)]">
                  267 / 250–400 words ✓
                </p>
              </div>
              <div class="mt-4 flex items-center justify-between rounded-2xl border border-line bg-white px-4 py-3">
                <span class="text-[12px] text-ink-muted">Caregiver signature</span>
                <svg viewBox="0 0 90 22" class="h-5 w-20 text-ink-secondary" aria-hidden="true">
                  <path d="M2 16 C 12 4, 18 20, 28 12 S 44 4, 52 12 S 70 20, 88 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </div>
            </div>
          )}

          {index === 1 && (
            <div class="feature-card mx-auto max-w-[560px] !rounded-[24px] p-6" style="box-shadow: var(--shadow-float)">
              <div class="flex items-center gap-2">
                {["Maladaptive (13)", "Replacement (14)", "Caregiver (3)"].map((tab, t) => (
                  <span
                    class:list={[
                      "rounded-full px-3 py-1.5 text-[10.5px] font-semibold",
                      t === 0
                        ? "bg-gradient-to-r from-brand-500 to-brand-400 text-white"
                        : "border border-line text-ink-muted",
                    ]}
                  >
                    {tab}
                  </span>
                ))}
              </div>

              <div class="mt-4 grid grid-cols-[1fr_auto] gap-4">
                <div class="overflow-hidden rounded-2xl border border-line">
                  <div class="grid grid-cols-5 border-b border-line bg-page-alt px-3 py-2 text-[9.5px] font-semibold uppercase tracking-wider text-ink-muted">
                    <span>Day</span><span>1</span><span>2</span><span>3</span><span>4</span>
                  </div>
                  {[
                    ["Mon", 4, 2, 3, 1],
                    ["Tue", 3, 3, 1, 2],
                    ["Wed", 5, 1, 2, 0],
                    ["Thu", 2, 2, 1, 1],
                  ].map((r) => (
                    <div class="grid grid-cols-5 border-b border-line px-3 py-2 text-[11px] tabular-nums last:border-0">
                      <span class="font-medium text-ink-secondary">{r[0]}</span>
                      {r.slice(1).map((v) => <span class="text-ink-muted">{v}</span>)}
                    </div>
                  ))}
                </div>

                <div class="flex w-[150px] flex-col justify-between rounded-2xl border border-line bg-page p-3">
                  <p class="text-[9.5px] font-semibold uppercase tracking-wider text-ink-muted">Trend</p>
                  <svg viewBox="0 0 130 80" class="w-full" aria-hidden="true">
                    <defs>
                      <linearGradient id="ds-fill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#037ECC" stop-opacity="0.16" />
                        <stop offset="100%" stop-color="#037ECC" stop-opacity="0" />
                      </linearGradient>
                    </defs>
                    <path d="M0 58 C 20 52, 35 62, 50 48 S 85 26, 100 32 S 120 18, 130 20 L 130 80 L 0 80 Z" fill="url(#ds-fill)" />
                    <path d="M0 58 C 20 52, 35 62, 50 48 S 85 26, 100 32 S 120 18, 130 20" fill="none" stroke="#037ECC" stroke-width="2.2" stroke-linecap="round" />
                  </svg>
                  <p class="text-[10px] font-medium text-[hsl(142_60%_32%)]">↓ 38% this month</p>
                </div>
              </div>
            </div>
          )}

          {index === 2 && (
            <div class="feature-card mx-auto max-w-[480px] !rounded-[24px] p-6" style="box-shadow: var(--shadow-float)">
              <p class="text-[15px] font-semibold">Authorization usage</p>
              <div class="mt-4 space-y-4">
                {[
                  { name: "M. Rivas · 97153", pct: 94, tone: "var(--color-crit)" },
                  { name: "S. Delgado · 97155", pct: 83, tone: "var(--color-warn)" },
                  { name: "T. Herrera · 97153", pct: 61, tone: "var(--color-ok)" },
                ].map((row) => (
                  <div>
                    <div class="flex items-baseline justify-between">
                      <span class="text-[12.5px] font-medium text-ink-secondary">{row.name}</span>
                      <span class="text-[12.5px] font-semibold tabular-nums">{row.pct}%</span>
                    </div>
                    <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-[hsl(240_15%_93%)]">
                      <div class="h-full rounded-full" style={`width:${row.pct}%; background:${row.tone}`}></div>
                    </div>
                  </div>
                ))}
              </div>
              <div class="mt-5 flex items-center gap-3 rounded-2xl border border-[hsl(38_80%_82%)] bg-[hsl(38_90%_96%)] px-4 py-3">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="hsl(38 85% 40%)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 9v4m0 4h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                </svg>
                <p class="text-[12px] text-[hsl(38_70%_28%)]">
                  <strong>Prior Auth #A-1024</strong> expires in 5 days
                </p>
              </div>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>
