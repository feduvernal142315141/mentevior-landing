---
// El ciclo conectado (la tesis del producto): dato → nota → supervisión →
// claim. Cuatro pasos numerados con una línea que los une en desktop.
import Section from "./Section.astro";

const steps = [
  {
    n: "01",
    title: "Collect",
    body: "Record frequency, duration, rate, percentage, and interval data during the session. Client graphs update automatically from the captured data.",
    icon: "M3 3v18h18M7 14l4-4 3 3 5-6",
  },
  {
    n: "02",
    title: "Document",
    body: "Create a structured note for the selected service using session data, field-level guidance, and built-in signature collection.",
    icon: "M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm0 0v6h6",
  },
  {
    n: "03",
    title: "Supervise",
    body: "Connect qualifying 97155 appointments to supervision records while monthly reports and coverage percentages update automatically.",
    icon: "M12 22s8-3.5 8-10V5l-8-3-8 3v7c0 6.5 8 10 8 10Z",
  },
  {
    n: "04",
    title: "Bill",
    body: "Once a note is signed, it moves to the billing queue with service units linked to the corresponding authorization.",
    icon: "M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1ZM8 8h8m-8 4h8m-8 4h5",
  },
];
---

<Section id="how" class="border-y border-line bg-page-alt">
  <div class="mx-auto max-w-[720px] text-center">
    <span class="eyebrow-pill text-eyebrow reveal">How it works</span>
    <h2 class="text-h2 reveal mt-5" style="--reveal-delay: 70ms">
      Document once. Keep every step connected.
    </h2>
    <p class="text-body-lg reveal mx-auto mt-5 max-w-[62ch] text-ink-muted" style="--reveal-delay: 140ms">
      From session data to signed notes and billing, one connected record moves through
      your workflow — without duplicate entry or conflicting information.
    </p>
  </div>

  <div class="relative mt-14">
    <!-- Línea que conecta los pasos (solo desktop) -->
    <div
      class="absolute left-0 right-0 top-[38px] hidden h-px lg:block"
      style="background: linear-gradient(90deg, transparent, rgba(3,126,204,0.35) 12%, rgba(3,126,204,0.35) 88%, transparent)"
      aria-hidden="true"
    >
    </div>

    <ol class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((step, i) => (
        <li class="feature-card reveal relative p-6" style={`--reveal-delay: ${i * 90}ms`}>
          <div class="flex items-center justify-between">
            <span class="icon-tile">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={step.icon} />
              </svg>
            </span>
            <span class="text-[26px] font-bold leading-none tracking-[-0.02em] tabular-nums text-brand-500/25">
              {step.n}
            </span>
          </div>
          <h3 class="mt-4 text-[16.5px] font-semibold tracking-[-0.01em] text-ink">{step.title}</h3>
          <p class="mt-2 text-body-sm leading-relaxed text-ink-muted">{step.body}</p>
        </li>
      ))}
    </ol>
  </div>
</Section>
