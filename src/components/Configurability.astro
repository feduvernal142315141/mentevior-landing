---
// La cuña competitiva (§4.7): configurabilidad por organización. El visual es
// una CAPTURA REAL de la pantalla de roles — la matriz de permisos por módulo
// y por acción existe, no hay que dibujarla.
import { Picture } from "astro:assets";
import rolesShot from "../assets/shot-roles.png";
---

<section class="py-[72px] lg:py-[128px]" id="configurability">
  <div class="mx-auto grid max-w-[1200px] grid-cols-1 items-center gap-12 px-6 md:px-8 lg:grid-cols-2 lg:gap-16 lg:px-12">
    <div class="reveal">
      <span class="eyebrow-pill text-eyebrow">Built to fit</span>
      <h2 class="text-h2 mt-5">Configured to your clinic, not the other way around</h2>
      <p class="mt-5 max-w-[62ch] leading-relaxed text-ink-muted">
        Service plans, data collection methods, document templates and role permissions
        are configured per organization. Your RBTs see exactly what they need. Your
        billing analyst never touches a clinical note. Your templates match your payer
        requirements — because you defined them.
      </p>
      <ul class="mt-8 space-y-3.5">
        {[
          "Service plans and billing codes defined by your company",
          "Data collection methods that match your clinical approach",
          "Document templates per report type",
          "Permissions per module and per action — not all-or-nothing",
        ].map((line, i) => (
          <li class="reveal flex items-start gap-3" style={`--reveal-delay: ${160 + i * 60}ms`}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-brand-500" aria-hidden="true">
              <path d="M20 6 9 17l-5-5" />
            </svg>
            <span class="text-[15px] text-ink-secondary">{line}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Matriz de permisos: captura real de Edit Role -->
    <div class="reveal" style="--reveal-delay: 120ms">
      <div class="feature-card mx-auto max-w-[520px] rounded-frame p-2" style="box-shadow: var(--shadow-float)">
        <Picture
          src={rolesShot}
          formats={["avif"]}
          fallbackFormat="webp"
          widths={[520, 1040]}
          sizes="(min-width: 1024px) 505px, 90vw"
          alt="Role editor with per-module permissions: read, create, edit, delete and block for each system module"
          loading="lazy"
          decoding="async"
          class="w-full rounded-[18px] border border-line"
        />
      </div>
    </div>
  </div>
</section>
