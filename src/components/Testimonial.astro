---
// Mientras no exista un testimonio real (§4.10), esta sección es una declaración
// de misión del equipo — sin persona, clínica ni cita fabricadas. Cuando llegue
// la primera cita de un design partner, recupera el formato <blockquote> con
// nombre, credencial (BCBA/Clinical Director) y foto real.
import { Image } from "astro:assets";
import emblem from "../assets/logo-emblem.png";
---

<section class="border-y border-line bg-page-alt py-[72px] lg:py-[128px]" id="why">
  <div class="reveal mx-auto max-w-[820px] px-6 text-center md:px-8">
    <span class="eyebrow-pill text-eyebrow">Why we build MenteVior</span>
    <p class="mt-7 text-[22px] font-medium leading-snug tracking-[-0.015em] text-ink md:text-[27px]">
      We build MenteVior alongside practicing BCBAs, around one conviction:
      a clinical team should document once — and spend its attention on clients,
      not on reconciling systems.
    </p>
    <div class="mt-8 flex items-center justify-center gap-3">
      <Image src={emblem} alt="" width={40} densities={[1, 2]} class="h-10 w-10 object-contain" />
      <span class="text-left">
        <span class="block text-[14px] font-semibold">The MenteVior team</span>
        <span class="block text-[12.5px] text-ink-muted">Built with BCBAs, for ABA practices</span>
      </span>
    </div>
  </div>
</section>
